<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=verilog --write_settings_files=off banco_registros -c banco_registros --vector_source="D:/Users/JuanDavidMedellinC/Downloads/proyectosQuartus/banco_registros/Waveform.vwf" --testbench_file="D:/Users/JuanDavidMedellinC/Downloads/proyectosQuartus/banco_registros/simulation/qsim/Waveform.vwf.vt"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=verilog --output_directory="D:/Users/JuanDavidMedellinC/Downloads/proyectosQuartus/banco_registros/simulation/qsim/" banco_registros -c banco_registros</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="D:/Users/JuanDavidMedellinC/Downloads/proyectosQuartus/banco_registros/simulation/qsim/" banco_registros -c banco_registros</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vlog -work work banco_registros.vo
vlog -work work Waveform.vwf.vt
vsim -c -t 1ps -L fiftyfivenm_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.banco_registros_vlg_vec_tst
vcd file -direction banco_registros.msim.vcd
vcd add -internal banco_registros_vlg_vec_tst/*
vcd add -internal banco_registros_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vlog -work work banco_registros.vo
vlog -work work Waveform.vwf.vt
vsim -novopt -c -t 1ps -L fiftyfivenm_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.banco_registros_vlg_vec_tst
vcd file -direction banco_registros.msim.vcd
vcd add -internal banco_registros_vlg_vec_tst/*
vcd add -internal banco_registros_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script_timing>
<hdl_lang>verilog</hdl_lang>
</simulation_settings>*/
